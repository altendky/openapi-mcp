{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "rebaseWhen": "conflicted",
  "pre-commit": { "enabled": true },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^rust-toolchain\\.toml$/"],
      "matchStrings": ["channel\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+)\""],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)\\.\\d+$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Cargo\\.toml$/"],
      "matchStrings": ["rust-version\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+)\""],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)\\.\\d+$"
    }
  ],
  // Preserve recommended exclusions and ignore generated Mise package metadata.
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.mise/locks/**"
  ],

  "packageRules": [
    {
      "description": "Keep Python on the selected minor release",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.14(?:\\.|$)/"
    },
    {
      "description": "Keep Node on the selected major release",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "node"
      ],
      "allowedVersions": "/^24(?:\\.|$)/"
    },
    {
      "description": "Changing the supported Node minimum is a manual decision",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "matchDepNames": [
        "node"
      ],
      "enabled": false
    },
    {
      "description": "Keep the minimum Node test at the manually selected support floor",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["node"],
      "matchDepTypes": ["uses-with"],
      "matchFileNames": [".github/workflows/ci.yml"],
      "matchCurrentValue": "/^22$/",
      "enabled": false
    },

    {
      "matchDepNames": ["rust-lang/rust"],
      "groupName": "Rust toolchain"
    },
    // Raising the MSRV is a deliberate compatibility decision.
    {
      "matchDepNames": ["rust-lang/rust"],
      "matchFileNames": ["Cargo.toml"],
      "enabled": false
    },
    {
      "matchDepNames": ["github:nextest-rs/nextest"],
      "extractVersion": "^cargo-nextest-(?<version>.+)$"
    },
    // Re-lock updated tools for every supported development platform.
    // The workflow permits Renovate's built-in Mise execution support.
    {
      "matchManagers": ["mise"],
      "postUpgradeTasks": {
        "commands": [
          "sh -c 'MISE_LOCKED=0 mise install --yes node python'",
          "sh -c 'MISE_LOCKED=0 mise lock --yes --platform linux-x64,linux-x64-musl,linux-arm64,linux-arm64-musl,macos-x64,macos-arm64,windows-x64 -- {{{depName}}}'"
        ],
        "fileFilters": ["mise.lock"],
        "executionMode": "update"
      }
    }
  ]
}
